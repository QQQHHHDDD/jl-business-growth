APP_ENV=development
DATABASE_URL=postgres://jl_business:change_me@127.0.0.1:5432/jl_business_dev?sslmode=disable
PUBLIC_BASE_URL=http://127.0.0.1:5173
SESSION_SECRET=replace-with-development-only-random-secret
COOKIE_SECURE=false
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_INITIAL_PASSWORD=replace-before-first-start
MAIL_MODE=file
FILE_ROOT=./.local/files
MAX_DOCUMENT_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=10
RELEASE_REPOSITORY=QQQHHHDDD/jl-business-growth
RELEASE_UPDATE_ENABLED=false
# GITHUB_TOKEN is optional for checking this public repository and must remain server-side.
GITHUB_TOKEN=
RELEASE_RUNTIME_ROOT=./.local/release-updater
# In production these remain /var/lib/jl-business-growth/release-updater/{requests,state}.
RELEASE_REQUEST_ROOT=./.local/release-updater/requests
RELEASE_STATE_ROOT=./.local/release-updater/state
RELEASE_BACKEND_ROOT=./.local/installed-releases
RELEASE_WEB_ROOT=./.local/installed-web
