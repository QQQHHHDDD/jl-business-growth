[Unit]
Description=JL Business Growth API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jl-business
Group=jl-business
WorkingDirectory=/opt/jl-business-growth/current
EnvironmentFile=/etc/jl-business-growth/jl-business-growth.env
ExecStart=/opt/jl-business-growth/current/jl-business-api
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jl-business-growth/files /var/lib/jl-business-growth/tmp /var/lib/jl-business-growth/release-updater/requests

[Install]
WantedBy=multi-user.target
