[Unit]
Description=Back up JL Business Growth database and files
After=postgresql.service

[Service]
Type=oneshot
User=jl-business
Group=jl-business
EnvironmentFile=/etc/jl-business-growth/jl-business-growth.env
ExecStart=/usr/local/libexec/jl-business-backup-db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/jl-business-growth
