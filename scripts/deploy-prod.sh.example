#!/usr/bin/env bash
set -euo pipefail

: "${RELEASE_VERSION:?set RELEASE_VERSION, for example v0.1.0}"
: "${DEPLOY_HOST:?set DEPLOY_HOST}"
: "${DEPLOY_USER:?set DEPLOY_USER}"
: "${ARTIFACT:?set ARTIFACT to the output of build-release.sh}"
if [[ ! "${RELEASE_VERSION}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo 'RELEASE_VERSION must match vX.Y.Z' >&2
  exit 1
fi

remote_root="/opt/jl-business-growth/releases/${RELEASE_VERSION}"
web_root="/var/www/jl-business-growth/releases/${RELEASE_VERSION}"
remote="${DEPLOY_USER}@${DEPLOY_HOST}"

test -d "${ARTIFACT}"
ssh "${remote}" "test ! -e '${remote_root}' && test ! -L '${remote_root}' && test ! -e '${web_root}' && test ! -L '${web_root}'"
remote_staging="$(ssh "${remote}" 'set -euo pipefail
staging="$(mktemp -d /var/tmp/jl-business-growth.XXXXXX)"
chmod 0700 "${staging}"
test ! -L "${staging}"
test "$(stat -c "%u" "${staging}")" = "$(id -u)"
test "$(stat -c "%a" "${staging}")" = 700
printf "%s\n" "${staging}"')"

cleanup_remote_staging() {
  case "${remote_staging}" in
    /var/tmp/jl-business-growth.[A-Za-z0-9_-]*) ;;
    *) return 0 ;;
  esac
  printf -v quoted_staging '%q' "${remote_staging}"
  ssh "${remote}" "rm -rf -- ${quoted_staging}" >/dev/null 2>&1 || true
}
trap cleanup_remote_staging EXIT

rsync -a --delete "${ARTIFACT}/" "${remote}:${remote_staging}/"

ssh "${remote}" bash -s -- "${remote_root}" "${web_root}" "${remote_staging}" "${RELEASE_VERSION}" <<'REMOTE'
set -euo pipefail

backend_root="$1"
web_root="$2"
staging_root="$3"
version="$4"

cleanup_staging() {
  rm -rf -- "$staging_root"
}
trap cleanup_staging EXIT
if [[ -L "$staging_root" || ! -d "$staging_root" || "$(stat -c '%u' "$staging_root")" != "$(id -u)" || "$(stat -c '%a' "$staging_root")" != "700" ]]; then
  echo 'remote staging must be a deploy-user-owned 0700 real directory' >&2
  exit 1
fi

sudo install -d -o root -g root -m 0755 "$backend_root" "$web_root"
sudo rsync -a --delete --chown=root:root --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r "$staging_root/" "$backend_root/"
sudo rsync -a --delete --chown=root:root --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r "$staging_root/web/" "$web_root/"
sudo chmod 0755 "$backend_root/jl-business-api" "$backend_root/jl-business-jobs" "$backend_root/scripts/backup-db.sh"

for release_root in "$backend_root" "$web_root"; do
  bad="$(mktemp "/tmp/jl-business-growth-permissions.XXXXXX")"
  sudo find "$release_root" -xdev \( ! -user root -o ! -group root -o -perm /022 \) -print -quit >"$bad"
  if [[ -s "$bad" ]]; then
    cat "$bad" >&2
    rm -f "$bad"
    exit 1
  fi
  rm -f "$bad"
done

sudo systemctl start jl-business-backup.service
if [[ "$(sudo systemctl show jl-business-backup.service -p ExecMainStatus --value)" != "0" ]]; then
  echo 'production database backup unit did not succeed' >&2
  exit 1
fi
sudo /usr/local/libexec/jl-business-migrate-release "$version"
sudo ln -sfnT "$backend_root" /opt/jl-business-growth/current
sudo ln -sfnT "$web_root" /var/www/jl-business-growth/current
sudo systemctl restart jl-business-api.service
sudo systemctl restart jl-business-jobs.timer
curl --fail --silent --show-error http://127.0.0.1:8080/api/health/live >/dev/null
curl --fail --silent --show-error http://127.0.0.1:8080/api/health/ready >/dev/null
REMOTE
printf 'release %s deployed to %s\n' "${RELEASE_VERSION}" "${DEPLOY_HOST}"
