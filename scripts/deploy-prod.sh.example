#!/usr/bin/env bash
set -euo pipefail

: "${RELEASE_VERSION:?set RELEASE_VERSION, for example v0.1.0}"
: "${DEPLOY_HOST:?set DEPLOY_HOST}"
: "${DEPLOY_USER:?set DEPLOY_USER}"
: "${ARTIFACT:?set ARTIFACT to the output of build-release.sh}"

remote_root="/opt/jl-business-growth/releases/${RELEASE_VERSION}"
web_root="/var/www/jl-business-growth/releases/${RELEASE_VERSION}"
remote="${DEPLOY_USER}@${DEPLOY_HOST}"

ssh "${remote}" "test ! -e '${remote_root}' && test ! -e '${web_root}'"
rsync -a --delete "${ARTIFACT}/" "${remote}:${remote_root}/"
ssh "${remote}" "sudo /opt/jl-business-growth/current/scripts/backup-db.sh"
ssh "${remote}" "cd '${remote_root}' && /usr/bin/goose -dir migrations postgres \"\$DATABASE_URL\" up"
ssh "${remote}" "mkdir -p /var/www/jl-business-growth/releases/${RELEASE_VERSION} && rsync -a --delete '${remote_root}/web/' '${web_root}/'"
ssh "${remote}" "ln -sfn '${remote_root}' /opt/jl-business-growth/current && ln -sfn '${web_root}' /var/www/jl-business-growth/current"
ssh "${remote}" "sudo systemctl restart jl-business-api.service && sudo systemctl restart jl-business-jobs.timer && curl --fail --silent --show-error http://127.0.0.1:8080/api/health/live >/dev/null"
printf 'release %s deployed to %s\n' "${RELEASE_VERSION}" "${DEPLOY_HOST}"
