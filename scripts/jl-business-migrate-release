#!/usr/bin/env bash
set -euo pipefail

validate_environment_file() {
    local environment_file="$1"
    local environment_parent="$2"
    local expected_owner_uid="${3:-0}"
    local expected_parent_owner_uid="${4:-${expected_owner_uid}}"
    local environment_owner environment_mode environment_parent_owner environment_parent_mode
    if [[ -L "${environment_parent}" || ! -d "${environment_parent}" || -L "${environment_file}" || ! -f "${environment_file}" ]]; then
        return 1
    fi
    environment_owner="$(stat -c '%u' "${environment_file}")"
    environment_mode="$(stat -c '%a' "${environment_file}")"
    environment_parent_owner="$(stat -c '%u' "${environment_parent}")"
    environment_parent_mode="$(stat -c '%a' "${environment_parent}")"
    if [[ "${environment_owner}" != "${expected_owner_uid}" || "${environment_parent_owner}" != "${expected_parent_owner_uid}" ]] || (( (8#${environment_mode} & 0022) != 0 )) || (( (8#${environment_parent_mode} & 0022) != 0 )); then
        return 1
    fi
}

main() {
    if [[ "$#" -ne 1 || ! "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "usage: $0 vX.Y.Z" >&2
        exit 2
    fi

    local version="$1"
    local environment_file="/etc/jl-business-growth/jl-business-growth.env"
    local environment_parent="/etc/jl-business-growth"
    local release_root="/opt/jl-business-growth/releases/${version}"
    local migrations_root="${release_root}/migrations"

    if ! validate_environment_file "${environment_file}" "${environment_parent}" 0 || [[ -L "${release_root}" || ! -d "${release_root}" || -L "${migrations_root}" || ! -d "${migrations_root}" ]]; then
        echo "固定 production migration 路径或 EnvironmentFile 不安全" >&2
        exit 1
    fi

    unset DATABASE_URL
    set -a
    # shellcheck disable=SC1091
    . "${environment_file}"
    set +a
    : "${DATABASE_URL:?DATABASE_URL is required in production environment file}"

    GOOSE_DRIVER=postgres \
    GOOSE_DBSTRING="${DATABASE_URL}" \
    exec /usr/bin/goose -dir "${migrations_root}" up
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
