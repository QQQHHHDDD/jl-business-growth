#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 1 || ! "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "usage: $0 vX.Y.Z" >&2
    exit 2
fi

version="$1"
environment_file="/etc/jl-business-growth/jl-business-growth.env"
release_root="/opt/jl-business-growth/releases/${version}"
migrations_root="${release_root}/migrations"

if [[ -L "${environment_file}" || ! -f "${environment_file}" || -L "${release_root}" || ! -d "${release_root}" || -L "${migrations_root}" || ! -d "${migrations_root}" ]]; then
    echo "固定 production migration 路径不存在或类型不安全" >&2
    exit 1
fi

unset DATABASE_URL
set -a
# shellcheck disable=SC1091
. "${environment_file}"
set +a
: "${DATABASE_URL:?DATABASE_URL is required in production environment file}"

exec /usr/bin/goose -dir "${migrations_root}" postgres "${DATABASE_URL}" up
